{
  "name": "arcana-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Arcana v2: graph-grounded learning workspace (FYP).",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "codegen": "pnpm --filter @arcana/schema codegen",
    "codegen:check": "pnpm --filter @arcana/schema codegen:check"
  }
}
