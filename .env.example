# Copy to .env and fill in. Never commit .env (this repo is public).
# Every variable is documented in refdocs/guides/env_setup.md.

# Modes: fake (default, no keys needed) or live
ARCANA_LLM_MODE=fake
ARCANA_EMBED_MODE=fake

# Required in live mode
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MONTHLY_CAP_USD=

# Optional
ARCANA_DATA_DIR=./data
LOG_LEVEL=INFO
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
